# Public HTTPS URLs configured as domains in the Coolify service UI.
VITE_WEB_URL=https://watch.example.com
VITE_SERVER_URL=https://api.example.com
VITE_APP_NAME=Watchbox
VITE_IS_ADULT_SITE=false

# Use long random values without URL-reserved characters for database and Redis passwords.
POSTGRES_USER=watchbox
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=watchbox
REDIS_PASSWORD=replace-with-a-long-random-password
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-48
# Required when the web and API use different subdomains. Use the shared parent domain.
AUTH_COOKIE_DOMAIN=.example.com

# Optional worker settings.
CONCURRENCY=1
DELETE_RAW_AFTER_TRANSCODE=false
